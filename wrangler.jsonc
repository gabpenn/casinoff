{
  "name": "casino",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "CASINO", "class_name": "Casino" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Casino"] }],
  "observability": { "enabled": true }
}
